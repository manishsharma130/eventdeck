{
  "name": "eventdeck-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:server": "pnpm --filter ./apps/server dev",
    "build:web": "pnpm --filter ./apps/web build",
    "build:server": "pnpm --filter ./apps/server build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test:server": "pnpm --filter ./apps/server test",
    "test": "pnpm -r --if-present test && pnpm test:web",
    "test:web": "pnpm --filter ./apps/server exec vitest run --root ../web"
  }
}
