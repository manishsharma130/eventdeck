{
  "name": "eventdeck",
  "version": "1.0.0",
  "description": "Local HTTP and WebSocket server for EventDeck",
  "type": "module",
  "bin": { "eventdeck": "./bin/eventdeck.js" },
  "files": ["dist", "bin"],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node ./bin/eventdeck.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": ["eventdeck", "websocket", "local-server"],
  "author": "Manish Sharma",
  "license": "MIT",
  "homepage": "https://github.com/manishsharma130/eventdeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manishsharma130/eventdeck.git",
    "directory": "apps/server"
  },
  "bugs": { "url": "https://github.com/manishsharma130/eventdeck/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "pino": "^9.9.4",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
